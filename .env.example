HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/dreamer.sqlite
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep stable: encrypts temporary responses and hashes request fingerprints.
DATA_KEY=
CLIPROXY_BASE_URL=http://127.0.0.1:8317/v1
# A normal CLIProxyAPI client key, NOT its management key.
CLIPROXY_API_KEY=
CLIPROXY_MODEL=
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=premium
REVENUECAT_MONTHLY_PRODUCT_ID=
ALLOW_SANDBOX=false
# Fail closed when this many generations have been reserved during a UTC day.
DAILY_GENERATION_LIMIT=200
# Leave unset unless behind a known reverse proxy; see README.
TRUST_PROXY=
